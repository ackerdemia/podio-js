{
  "name": "podio-js",
  "version": "1.6.4",
  "description": "Podio Platform JavaScript SDK for NodeJS and the browser",
  "main": "lib/index",
  "scripts": {
    "test": "node node_modules/jasmine/bin/jasmine.js test/*[sS]pec.js",
    "coverage": "./node_modules/.bin/istanbul cover ./node_modules/jasmine/bin/jasmine.js test/*[sS]pec.js",
    "bundle": "mkdir -p dist && browserify lib/podio-js.js -s PodioJS > dist/podio-js.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/podio/podio-js.git"
  },
  "contributors": [
    "Marc Høegh <marc.hoegh@hoisthq.com>",
    "Domenico Matteo <matteo.domenico@gmail.com>"
  ],
  "keywords": [
    "podio",
    "beagle",
    "platform"
  ],
  "author": "Søren Brokær <rasmussen@podio.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/podio/podio-js/issues"
  },
  "homepage": "https://github.com/podio/podio-js",
  "devDependencies": {
    "browserify": "17.0.0",
    "coveralls": "3.1.1",
    "istanbul": "0.4.5",
    "jasmine": "4.5.0",
    "sinon": "1.17.7"
  },
  "dependencies": {
    "es6-promise": "4.2.8",
    "faye": "1.4.3",
    "lodash": "^4.18.1",
    "superagent": "5.3.1",
    "urijs": "1.19.11"
  }
}
